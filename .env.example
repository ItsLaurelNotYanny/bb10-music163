# Example environment file for Docker Compose deployment (copy to .env; never commit real secrets).
# Generate token with: openssl rand -hex 32
GATEWAY_TOKEN=replace-with-strong-gateway-token

# IMPORTANT: Inside a bridge container, 127.0.0.1 is the container itself, NOT the NAS host.
# Point to the NAS LAN/Tailscale IP or use host.docker.internal:1080 when socks5-proxy publishes port 1080 on the host.
GATEWAY_API_PROXY=socks5h://host.docker.internal:1080
# Leave empty for split routing (API/auth via proxy, audio CDN streamed directly).
GATEWAY_MEDIA_PROXY=
GATEWAY_TLS_VERIFY=true
GATEWAY_LISTEN=0.0.0.0:8090
GATEWAY_STATE_DIR=/data/state
# Host port on the NAS (defaults to 16380 to avoid colliding with common 8080/8090 NAS services).
GATEWAY_HOST_PORT=16380
# Idle auto-sleep timeout when using docker-compose.nas-autosleep.yml
IDLE_SLEEP_DURATION=10m
# Host directory containing server.crt and server.key signed by your internal Root CA (used by Traefik TLS).
CERTS_DIR=./certs
